machine:
  install:
    disk: /dev/sda
  kubelet:
    nodeIP:
      validSubnets:
        - ${node_ip}/24
    extraArgs:
      rotate-server-certificates: true
  network:
    interfaces:
      - interface: eth0
        dhcp: false
        addresses:
          - ${node_ip}/24
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
        vip:
          ip: ${cluster_vip}
    nameservers:
%{ for dns_server in dns_servers ~}
      - ${dns_server}
%{ endfor ~}
  certSANs:
    - ${cluster_endpoint}
    - ${cluster_vip}
    - ${node_ip}
  nodeLabels:
    topology.kubernetes.io/region: ${cluster_name}
    topology.kubernetes.io/zone: ${proxmox_node_name}
  time:
    servers:
      - ntp.metas.ch
cluster:
  etcd:
    advertisedSubnets:
      - ${node_ip}/24
---
# Talos v1.12+ requires hostname to be set via HostnameConfig rather than
# machine.network.hostname to avoid conflict with the auto: stable default.
apiVersion: v1alpha1
kind: HostnameConfig
auto: off
hostname: ${node_hostname}
